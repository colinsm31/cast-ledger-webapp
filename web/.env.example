# Copy to .env.local and fill in. .env.local is gitignored.
# From the Supabase dashboard: Project Settings → API.
# The anon (publishable) key is a public client key — RLS enforces access.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to "test" in the test environment to show a striped "TEST" navbar.
# Leave unset (or "production") for the real store — no stripe.
VITE_APP_ENV=production
